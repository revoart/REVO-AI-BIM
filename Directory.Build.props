<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>RevoStudioz</Company>
    <Product>Revo AI BIM</Product>
    <Copyright>Copyright (c) 2026 RevoStudioz</Copyright>
    <Version>0.8.2</Version>
    <AssemblyVersion>0.8.2.0</AssemblyVersion>
    <FileVersion>0.8.2.0</FileVersion>
    <NeutralLanguage>en-CA</NeutralLanguage>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Revit version selection.
      dotnet build -p:RevitVersion=2026   (default; Revit 2026 installed on this machine)
      dotnet build -p:RevitVersion=2027   (Revit 2027 installed on this machine)

    Revit 2025 is NOT installed on this machine and cannot be built/tested here.
    Its target framework mapping is kept for future use but is unverified.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>

    <RevitApiDir Condition="'$(RevitApiDir)' == '' and '$(RevitVersion)' == '2026'">C:\Program Files\Autodesk\Revit 2026</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == '' and '$(RevitVersion)' == '2027'">C:\Program Files\Autodesk\Revit 2027</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == '' and '$(RevitVersion)' == '2025'">C:\Program Files\Autodesk\Revit 2025</RevitApiDir>

    <!-- Revit 2026 and 2027 both host .NET 10 (verified from RevitAPI.runtimeconfig.json). -->
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2026' or '$(RevitVersion)' == '2027'">net10.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</RevitTargetFramework>
  </PropertyGroup>

</Project>
