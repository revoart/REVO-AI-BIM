<Window x:Class="RevoAI.Revit.UI.ImportScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Import point cloud"
        Width="780" Height="820"
        MinWidth="680" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Import point cloud" Style="{StaticResource TitleText}" />
            <TextBlock Text="The Python engine reads the scan, preserves its coordinate system and writes a chunked local store."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Scan file" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0"
                                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     ToolTip="E57, LAS, LAZ, PLY, XYZ or TXT" />
                            <Button Grid.Column="1" Content="Browse…"
                                    Command="{Binding BrowseCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Units and storage" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="SOURCE UNIT" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding SelectedUnit}"
                                          IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="CHUNK SIZE (M)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ChunkSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                                <TextBlock Text="Each scan is written to its own subfolder with metadata.json and chunk files."
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Preprocessing" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Optional. Preprocessing changes the stored points; source bounds and unit remain recorded in metadata."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                        <CheckBox Content="Remove statistical outliers"
                                  IsChecked="{Binding RemoveOutliers}"
                                  IsEnabled="{Binding IsNotBusy}" />
                        <Grid Margin="24,8,0,14" IsEnabled="{Binding RemoveOutliers}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="NEIGHBOURS" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OutlierNeighborsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="STD-DEVIATION RATIO" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OutlierStdRatioText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Voxel downsample"
                                  IsChecked="{Binding VoxelDownsample}"
                                  IsEnabled="{Binding IsNotBusy}" />
                        <StackPanel Margin="24,8,0,0" IsEnabled="{Binding VoxelDownsample}">
                            <TextBlock Text="VOXEL SIZE (M)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding VoxelSizeText, UpdateSourceTrigger=PropertyChanged}" Width="180"
                                     HorizontalAlignment="Left" />
                        </StackPanel>

                        <CheckBox Content="Overwrite an existing scan with the same id"
                                  IsChecked="{Binding Overwrite}"
                                  IsEnabled="{Binding IsNotBusy}"
                                  Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Import error" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                    Command="{Binding OpenStoreFolderCommand}"
                                    Style="{StaticResource GhostButton}" />
                            <TextBlock Text="Import result" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ResultSummary}" FontFamily="Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding WarningsText}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding ImportButtonText}"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="12,0,8,0" />
            <Button Grid.Column="2" Content="Close" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
