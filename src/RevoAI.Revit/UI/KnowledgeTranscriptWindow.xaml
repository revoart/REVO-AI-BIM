<Window x:Class="RevoAI.Revit.UI.KnowledgeTranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Import transcript"
        Width="760" Height="680"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CharcoalBrush}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Import a transcript" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Store the source, creator, licence and text locally. Transcripts are never uploaded."
                           Foreground="#AEB7C4" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleBox" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="CREATOR" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CreatorBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LICENCE" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LicenseBox" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="SOURCE URL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UrlBox" Margin="0,0,0,14" />

                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Load text file…" Click="BrowseButton_Click"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <TextBlock Text="TRANSCRIPT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="TranscriptBox" Height="260" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Paste a transcript you are authorized to use, or load a local .txt/.md/.vtt file."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Import transcript" Click="ImportButton_Click"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
