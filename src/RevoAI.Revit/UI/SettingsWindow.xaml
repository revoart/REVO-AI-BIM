<Window x:Class="RevoAI.Revit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Settings"
        Width="660" Height="620"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CharcoalBrush}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Python engine and processing configuration"
                           Foreground="#AEB7C4" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Python engine" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Leave the interpreter empty to auto-select the repository virtual environment."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                        <TextBlock Text="PYTHON EXECUTABLE" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PythonExecutable, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Full path to python.exe, or empty for auto-detect" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowsePythonCommand}"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="ENGINE ROOT" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EngineRoot, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Folder containing src\RevoAI.Engine" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseEngineRootCommand}"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="STARTUP TIMEOUT (S)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StartupTimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="REQUEST TIMEOUT (S)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RequestTimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Locations" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="CONFIGURATION FILE" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource FieldValue}" />
                        <TextBlock Text="LOG FOLDER" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource FieldValue}" />
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
