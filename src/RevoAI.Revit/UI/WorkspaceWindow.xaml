<Window x:Class="RevoAI.Revit.UI.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Workspace"
        Width="1320" Height="880"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="StageNavButton" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#C9D1DE" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StageProjectButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProjectStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StageImportButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImportStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StageAnalyzeButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAnalyzeStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StageGenerateButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGenerateStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StageSubscriptionButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSubscriptionStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StageKnowledgeButton" TargetType="Button" BasedOn="{StaticResource StageNavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKnowledgeStage}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PlanCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BillingButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="BillingMonthlyButton" TargetType="Button" BasedOn="{StaticResource BillingButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Subscription.IsMonthly}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BillingYearlyButton" TargetType="Button" BasedOn="{StaticResource BillingButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Subscription.IsYearly}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource CharcoalBrush}">
            <DockPanel Margin="22,26,22,22">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="REVO" Foreground="White" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="AI BIM" Foreground="{StaticResource BlueBrush}" FontSize="18" FontWeight="SemiBold" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,18,0,18" />
                    <TextBlock Text="WORKFLOW" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Project setup" Command="{Binding ShowProjectStageCommand}"
                            Style="{StaticResource StageProjectButton}" />
                    <Button Content="1   Import scan" Command="{Binding ShowImportStageCommand}"
                            Style="{StaticResource StageImportButton}" />
                    <Button Content="2   Analyze scan" Command="{Binding ShowAnalysisStageCommand}"
                            Style="{StaticResource StageAnalyzeButton}" />
                    <Button Content="3   Generate BIM" Command="{Binding ShowGenerateStageCommand}"
                            Style="{StaticResource StageGenerateButton}" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,14,0,14" />
                    <TextBlock Text="KNOWLEDGE" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Knowledge library" Command="{Binding ShowKnowledgeStageCommand}"
                            Style="{StaticResource StageKnowledgeButton}" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,14,0,14" />
                    <TextBlock Text="ACCOUNT" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Subscription" Command="{Binding ShowSubscriptionStageCommand}"
                            Style="{StaticResource StageSubscriptionButton}" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,18,0,18" />
                    <TextBlock Text="ENGINE" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EngineStatus}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding EngineDetails}" Foreground="#AEB7C4" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="110" />
                    <Button Content="Test connection" Command="{Binding TestEngineCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding ProductVersion, StringFormat='Version {0}'}"
                               Foreground="#8A94A6" FontSize="11" />
                    <TextBlock Text="{Binding EngineProtocol, StringFormat='Protocol {0}'}"
                               Foreground="#8A94A6" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="RevoStudioz" Foreground="#5E6878" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Current scan" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ScanFileName}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ScanStatus}" Foreground="#AEB7C4" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding PointCount}" Foreground="#AEB7C4" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,14,0,10"
                            Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="MODEL REFERENCE" Foreground="#8A94A6" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,6"
                               Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding ReferenceCloudButtonText}"
                            Command="{Binding ToggleReferenceCloudCommand}"
                            Style="{StaticResource SidebarActionButton}"
                            Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ReferenceCloudStatus}" Foreground="#AEB7C4" FontSize="10"
                               TextWrapping="Wrap" Margin="2,6,0,0"
                               Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Sampled markers for visual reference, not native scan data."
                               Foreground="#7C8798" FontSize="10" TextWrapping="Wrap" Margin="2,4,0,0"
                               Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="120" IsIndeterminate="True" Margin="0,0,16,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding StageTitle}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding StageSubtitle}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
                <Grid>

                    <!-- Project stage -->
                    <StackPanel Visibility="{Binding IsProjectStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Project information" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="PROJECT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="REVIT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding RevitVersion}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="PROJECT UNITS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding LengthUnitLabel}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="LEVELS IN MODEL" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Levels.Count}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="DOCUMENT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding DocumentPath}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Levels" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ElevationUnitLabel, StringFormat='Elevations are shown in {0}. New levels are written to Revit only when you click Create levels.'}"
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <DataGrid ItemsSource="{Binding Levels}"
                                          SelectedItem="{Binding SelectedLevel}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="190" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Elevation" Binding="{Binding ElevationText}" Width="130" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding NewLevelName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="New level name" />
                                    <TextBox Grid.Column="1" Margin="0,0,8,0"
                                             Text="{Binding NewLevelElevationText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Elevation in project units" />
                                    <Button Grid.Column="2" Content="Add" Command="{Binding AddLevelCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveLevelCommand}"
                                            Style="{StaticResource GhostButton}" />
                                </Grid>
                                <Button Content="Create levels in Revit"
                                        Command="{Binding CreateLevelsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Processing and diagnostics" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PLANNED / CREATED ELEMENTS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding DetectedElements}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MEAN CONFIDENCE" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding EngineDetails}" Style="{StaticResource MutedText}" Margin="0,10,0,6" />
                                <TextBlock Text="{Binding LogDirectory, StringFormat='Logs: {0}'}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test connection" Command="{Binding TestEngineCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                                            Style="{StaticResource GhostButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Import stage -->
                    <StackPanel Visibility="{Binding IsImportStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Current scan" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SCAN FILE" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanFileName}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="POINTS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding PointCount}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanFormat}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="UNIT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanUnit}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CHUNKS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanChunks}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="BOUNDS (M)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ScanBounds}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="{Binding ScanWarnings}" Style="{StaticResource MutedText}" />
                                <Button Content="Continue to Analyze →"
                                        Command="{Binding ShowAnalysisStageCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Import scan" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <TextBlock Text="The Python engine reads the scan, preserves its coordinate system and writes a chunked local store. No Revit geometry is created."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <TextBlock Text="SCAN FILE" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding Import.FilePath, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Import.IsNotBusy}" />
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding Import.BrowseCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                                <TextBlock Text="{Binding Import.FormatLabel}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="SOURCE UNIT" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Import.UnitOptions}" SelectedItem="{Binding Import.SelectedUnit}"
                                                  IsEnabled="{Binding Import.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="CHUNK SIZE (M)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Import.ChunkSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Import.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Import.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Import.IsNotBusy}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Preprocessing" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                                <TextBlock Text="Optional. Source bounds and unit remain recorded in metadata."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                <CheckBox Content="Remove statistical outliers" IsChecked="{Binding Import.RemoveOutliers}"
                                          IsEnabled="{Binding Import.IsNotBusy}" />
                                <Grid Margin="24,8,0,12" IsEnabled="{Binding Import.RemoveOutliers}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="NEIGHBOURS" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Import.OutlierNeighborsText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="STD-DEVIATION RATIO" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Import.OutlierStdRatioText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Voxel downsample" IsChecked="{Binding Import.VoxelDownsample}"
                                          IsEnabled="{Binding Import.IsNotBusy}" />
                                <StackPanel Margin="24,8,0,0" IsEnabled="{Binding Import.VoxelDownsample}">
                                    <TextBlock Text="VOXEL SIZE (M)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Import.VoxelSizeText, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Content="Overwrite an existing scan with the same id" IsChecked="{Binding Import.Overwrite}"
                                          IsEnabled="{Binding Import.IsNotBusy}" Margin="0,16,0,0" />

                                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}"
                                        Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Import error" Style="{StaticResource SectionTitle}"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Import.ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding Import.HasResult, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                                    Command="{Binding Import.OpenStoreFolderCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                            <TextBlock Text="Import result" Style="{StaticResource SectionTitle}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Import.ResultSummary}" FontFamily="Consolas" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                        <TextBlock Text="{Binding Import.WarningsText}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="{Binding Import.ImportButtonText}" Command="{Binding Import.ImportCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Import.StatusMessage}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Analyze stage -->
                    <StackPanel Visibility="{Binding IsAnalyzeStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Scan Analysis" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <TextBlock Text="Geometric plane segmentation of the imported point cloud. This is a measured plane-fit baseline, not a trained neural network."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <TextBlock Text="POINT CLOUD STORE" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Analysis.StorePath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Analysis.IsNotBusy}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="VOXEL SIZE (M, 0 = OFF)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.VoxelSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                        <TextBlock Text="MAX ANALYSIS POINTS" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.MaxPointsText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                        <TextBlock Text="PLANE DISTANCE (M)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.PlaneDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="MIN PLANE POINTS" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.MinPlanePointsText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="MAX PLANES" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.MaxPlanesText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Analysis.ConfidenceThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Analysis.IsNotBusy}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}"
                                        Visibility="{Binding Analysis.HasError, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Analysis error" Style="{StaticResource SectionTitle}"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Analysis.ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding Analysis.HasResult, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                                    Command="{Binding Analysis.OpenStoreFolderCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                            <TextBlock Text="Analysis result" Style="{StaticResource SectionTitle}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Analysis.ResultSummary}" FontFamily="Consolas" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Detected planar instances" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                        <DataGrid ItemsSource="{Binding Analysis.Elements}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal" MaxHeight="300" FontSize="12">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120" />
                                                <DataGridTextColumn Header="Points" Binding="{Binding PointCount, StringFormat={}{0:N0}}" Width="90" />
                                                <DataGridTextColumn Header="Area m²" Binding="{Binding AreaM2, StringFormat={}{0:0.##}}" Width="90" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="100" />
                                                <DataGridTextColumn Header="Plane error (m)" Binding="{Binding Signals.FitErrorMeters, StringFormat={}{0:0.####}}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                        <TextBlock Text="{Binding Analysis.WarningsText}" Style="{StaticResource MutedText}" />
                                        <Button Content="Continue to Generate BIM →" Command="{Binding ShowGenerateStageCommand}"
                                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="{Binding Analysis.RunButtonText}" Command="{Binding Analysis.RunCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Analysis.StatusMessage}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Generate stage -->
                    <StackPanel Visibility="{Binding IsGenerateStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Generate BIM" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <TextBlock Text="Preview native Revit floors and walls from Scan Analysis. Nothing is created until you click Create in Revit."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <TextBlock Text="SCAN STORE" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Generate.StorePath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Generate.IsNotBusy}" />
                                <TextBlock Text="The store must already contain analysis/segmentation.json from Scan Analysis."
                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                                <Grid Margin="0,14,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PLAN SOURCE" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Generate.ProviderOptions}"
                                              SelectedItem="{Binding Generate.SelectedProvider}"
                                              IsEnabled="{Binding Generate.IsNotBusy}" />
                                </Grid>
                                <Grid Visibility="{Binding Generate.IsExternalPlanProvider, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding Generate.ExternalPlanPath, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Generate.IsNotBusy}" />
                                    <Button Grid.Column="1" Content="Browse plan…"
                                            Command="{Binding Generate.BrowseExternalPlanCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                                <TextBlock Text="The external tool must emit the documented levels/floors/walls JSON schema in metres. The engine validates it before preview."
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           Visibility="{Binding Generate.IsExternalPlanProvider, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Revo-managed subscription mode. The backend chooses the Astra model; the OpenAI key never enters the add-in. Sign-in and entitlement are handled by the Revo service."
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           Visibility="{Binding Generate.IsAstraSubscriptionProvider, Converter={StaticResource BoolToVisibility}}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Generate.ConfidenceThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Generate.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                        <TextBlock Text="FALLBACK WALL HEIGHT (M)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Generate.FallbackWallHeightText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Generate.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                        <TextBlock Text="LEVEL TOLERANCE (M)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Generate.LevelToleranceText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Generate.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="MAX ELEMENTS" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Generate.MaxElementsText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Generate.IsNotBusy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                                        <CheckBox Content="Mark created floors and walls as REVO-INFERRED"
                                                  IsChecked="{Binding Generate.MarkInferred}"
                                                  IsEnabled="{Binding Generate.IsNotBusy}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}"
                                        Visibility="{Binding Generate.HasError, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Generation error" Style="{StaticResource SectionTitle}"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Generate.ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding Generate.HasPlan, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                                    Command="{Binding Generate.OpenStoreFolderCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                            <TextBlock Text="Plan preview" Style="{StaticResource SectionTitle}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Generate.PlanSummary}" FontFamily="Consolas" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Floors" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                        <DataGrid ItemsSource="{Binding Generate.Floors}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal" MaxHeight="180" FontSize="12">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="130" />
                                                <DataGridTextColumn Header="Level" Binding="{Binding LevelId}" Width="110" />
                                                <DataGridTextColumn Header="Area m²" Binding="{Binding AreaM2, StringFormat={}{0:0.##}}" Width="100" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Walls" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                        <DataGrid ItemsSource="{Binding Generate.Walls}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal" MaxHeight="220" FontSize="12">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="130" />
                                                <DataGridTextColumn Header="Level" Binding="{Binding LevelId}" Width="110" />
                                                <DataGridTextColumn Header="Height m" Binding="{Binding HeightMeters, StringFormat={}{0:0.###}}" Width="100" />
                                                <DataGridTextColumn Header="Height source" Binding="{Binding HeightSource}" Width="120" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                        <TextBlock Text="{Binding Generate.WarningsText}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="{Binding Generate.PreviewButtonText}" Command="{Binding Generate.PreviewCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="{Binding Generate.BuildButtonText}" Command="{Binding Generate.BuildCommand}"
                                            IsEnabled="{Binding Generate.HasPlan}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Generate.StatusMessage}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Knowledge stage -->
                    <StackPanel Visibility="{Binding IsKnowledgeStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Backup" Command="{Binding Knowledge.BackupCommand}"
                                                Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                                        <Button Content="Export" Command="{Binding Knowledge.ExportCommand}"
                                                Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                                        <Button Content="Open folder" Command="{Binding Knowledge.OpenRootCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Local knowledge library" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Knowledge.StatsText}" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Import document…" Command="{Binding Knowledge.ImportDocumentCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                    <Button Content="Import transcript…" Command="{Binding Knowledge.ImportTranscriptCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                    <Button Content="Extract active project" Command="{Binding Knowledge.ExtractProjectCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                    <ComboBox Width="170" Margin="0,0,0,8"
                                              ItemsSource="{Binding Knowledge.DocumentKindOptions}"
                                              SelectedItem="{Binding Knowledge.DocumentKind}"
                                              ToolTip="Source type used when importing a document" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Knowledge.StatusMessage}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Knowledge.ErrorMessage}" Foreground="#B42318"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding Knowledge.HasError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Search and review" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <TextBlock Text="Only approved records are used as established guidance. Extracted sources and pending records stay visibly separate."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding Knowledge.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search subjects, descriptions, transcripts and documents" />
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                              ItemsSource="{Binding Knowledge.StatusOptions}"
                                              SelectedItem="{Binding Knowledge.SelectedStatus}" />
                                    <Button Grid.Column="2" Content="Search" Command="{Binding Knowledge.SearchCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="430" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Background="White">
                                        <ListBox ItemsSource="{Binding Knowledge.Results}"
                                                 SelectedItem="{Binding Knowledge.SelectedItem}"
                                                 BorderThickness="0" Background="Transparent"
                                                 MinHeight="360" MaxHeight="460">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="10,8">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                                                       Foreground="{StaticResource BlueBrush}" FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding KindLabel}" Foreground="#8A94A6"
                                                                       FontSize="9" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Background="White" Padding="16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                            <StackPanel>
                                                <TextBlock Text="DETAILS" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding Knowledge.DetailsText}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}" FontSize="12" />
                                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />
                                                <TextBlock Text="PROVENANCE AND REVIEW HISTORY" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding Knowledge.ProvenanceText}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button Content="Approve" Command="{Binding Knowledge.ApproveCommand}"
                                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                                    <Button Content="Needs correction" Command="{Binding Knowledge.NeedsCorrectionCommand}"
                                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                                    <Button Content="Reject" Command="{Binding Knowledge.RejectCommand}"
                                                            Style="{StaticResource SecondaryButton}" />
                                                    <Button Content="Delete" Command="{Binding Knowledge.DeleteCommand}"
                                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Subscription stage -->
                    <StackPanel Visibility="{Binding IsSubscriptionStage, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Monthly" Command="{Binding Subscription.ShowMonthlyCommand}"
                                                Style="{StaticResource BillingMonthlyButton}" />
                                        <Button Content="Yearly · save 10%" Command="{Binding Subscription.ShowYearlyCommand}"
                                                Style="{StaticResource BillingYearlyButton}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Revo AI BIM subscription" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Choose a plan for the complete scan-to-BIM workflow, including Revo-managed Astra analysis."
                                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Subscription.BillingNote}" Style="{StaticResource MutedText}"
                                           Margin="0,8,0,18" />

                                <ItemsControl ItemsSource="{Binding Subscription.Plans}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PlanCard}" Margin="0,0,12,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="RECOMMENDED"
                                                                   Foreground="{StaticResource BlueBrush}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Audience}" Style="{StaticResource MutedText}"
                                                               Margin="0,2,0,14" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding DisplayPrice}" FontSize="28" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding BillingSuffix}" FontSize="13"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Bottom" Margin="6,0,0,5" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding YearlyEquivalent}" Style="{StaticResource MutedText}"
                                                               Margin="0,0,0,12" />
                                                    <TextBlock Text="{Binding Seats}" Style="{StaticResource FieldLabel}"
                                                               Foreground="{StaticResource BlueBrush}" />
                                                    <TextBlock Text="{Binding FeatureText}" Style="{StaticResource MutedText}"
                                                               Margin="0,10,0,16" />
                                                    <Button Content="Choose plan" Command="{Binding SelectCommand}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{StaticResource BlueSoftBrush}" CornerRadius="6" Padding="14,10"
                                        Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subscription.SelectedPlan, StringFormat='Selected: {0}'}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Subscription.StatusMessage}" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="28,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Single-window workflow · Import → Analyze → Generate"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
