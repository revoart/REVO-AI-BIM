<Window x:Class="RevoAI.Revit.UI.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM"
        Width="430" Height="820"
        MinWidth="390" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="CompactSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SmallTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CharcoalBrush}" Padding="20,18">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProductVersion, StringFormat='v{0}'}"
                               Foreground="#8A94A6" FontSize="10" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="REVO AI BIM" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Scan to Revit, measured first" Foreground="{StaticResource BlueBrush}"
                                   FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding ProjectName}" Foreground="White" FontSize="13"
                           FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#AEB7C4" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,8">
            <StackPanel>

                <!-- 1. Scan -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanUnit}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="1  Scan" Style="{StaticResource SmallTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ScanFileName}" Style="{StaticResource FieldValue}"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding PointCount}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBox Text="{Binding Import.FilePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Import.IsNotBusy}" Margin="0,10,0,0"
                                 ToolTip="Point cloud file (E57, LAS/LAZ, PLY, XYZ)" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Browse" Command="{Binding Import.BrowseCommand}"
                                    Style="{StaticResource CompactSecondary}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Content="{Binding Import.ImportButtonText}"
                                    Command="{Binding Import.ImportCommand}" Style="{StaticResource CompactButton}" />
                        </Grid>
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                     Visibility="{Binding Import.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Import.StatusMessage}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Import.ErrorMessage}" Foreground="#B42318" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Import.HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 2. Analyse -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2  Analyse" Style="{StaticResource SmallTitle}" />
                        <TextBlock Text="Find floors, walls and openings in the scan."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Button Content="{Binding Analysis.RunButtonText}"
                                Command="{Binding Analysis.RunCommand}"
                                Style="{StaticResource CompactSecondary}" />
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                     Visibility="{Binding Analysis.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Analysis.ResultSummary}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Analysis.ErrorMessage}" Foreground="#B42318" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Analysis.HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 3. Build -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Generate.AiProviderLabel}" Foreground="{StaticResource BlueBrush}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="3  Build" Style="{StaticResource SmallTitle}" />
                        </DockPanel>
                        <TextBlock Text="AI reads plan and elevation snapshots, writes a measured schedule, then Revit builds it."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Button Content="{Binding Generate.PreviewButtonText}"
                                Command="{Binding Generate.PreviewCommand}"
                                Style="{StaticResource CompactSecondary}" />
                        <Button Content="{Binding Generate.BuildButtonText}"
                                Command="{Binding Generate.BuildCommand}"
                                Style="{StaticResource CompactButton}" Margin="0,6,0,0" />
                        <ProgressBar Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding Generate.BuildProgressValue, Mode=OneWay}" Margin="0,8,0,0"
                                     Visibility="{Binding Generate.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Generate.BuildProgressText}" Style="{StaticResource MutedText}"
                                   FontSize="10" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Generate.PlanSummary}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" FontSize="10.5" Margin="0,8,0,0"
                                   Visibility="{Binding Generate.HasPlan, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="#FDECEA" CornerRadius="5" Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding Generate.HasBlockingIssues, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Build blocked" Foreground="#B42318" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Generate.BlockingIssuesText}" Foreground="#B42318"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Generate.StatusMessage}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Generate.ErrorMessage}" Foreground="#B42318" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Generate.HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Point cloud -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                        Visibility="{Binding CanToggleReferenceCloud, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Point cloud" Style="{StaticResource SmallTitle}" />
                        <TextBlock Text="{Binding ReferenceCloudStatus}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,3,0,8" />
                        <Button Content="{Binding ReferenceCloudButtonText}"
                                Command="{Binding ToggleReferenceCloudCommand}"
                                Style="{StaticResource CompactSecondary}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="RevoStudioz" Foreground="{StaticResource MutedBrush}"
                           FontSize="10" VerticalAlignment="Center" />
                <TextBlock Text="{Binding EngineProtocol, StringFormat='AI workspace · protocol {0}'}"
                           Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
