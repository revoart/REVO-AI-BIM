<Window x:Class="RevoAI.Revit.UI.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Workspace"
        Width="1180" Height="820"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource CharcoalBrush}">
            <DockPanel Margin="24,28,24,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="REVO" Foreground="White" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="AI BIM" Foreground="{StaticResource BlueBrush}" FontSize="18" FontWeight="SemiBold" />
                    <Border Height="1" Background="#33FFFFFF" Margin="0,18,0,18" />
                    <TextBlock Text="SCAN TO BIM" Foreground="#8A94A6" FontSize="11" FontWeight="SemiBold" />
                    <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="PHASE 3 · POINT CLOUD" Foreground="#C9D1DE" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding ProductVersion, StringFormat='Version {0}'}"
                               Foreground="#8A94A6" FontSize="11" />
                    <TextBlock Text="{Binding EngineProtocol, StringFormat='Protocol {0}'}"
                               Foreground="#8A94A6" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="RevoStudioz" Foreground="#5E6878" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ENGINE" Foreground="#8A94A6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EngineStatus}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding EngineDetails}" Foreground="#AEB7C4" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="90" />
                    <Button Content="Test connection"
                            Command="{Binding TestEngineCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,22">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="120" IsIndeterminate="True" Margin="0,0,16,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Workspace" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding DocumentTitle}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
                <StackPanel>

                    <!-- Project -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Project information" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="PROJECT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="REVIT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding RevitVersion}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="PROJECT UNITS" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding LengthUnitLabel}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="LEVELS IN MODEL" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Levels.Count}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="DOCUMENT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DocumentPath}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Point cloud -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Point cloud" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SCAN FILE" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanFileName}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="POINTS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding PointCount}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanFormat}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="UNIT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanUnit}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CHUNKS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ScanChunks}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="BOUNDS (M)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ScanBounds}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="LOCAL STORE" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ScanStorePath}" Style="{StaticResource FieldValue}"
                                               ToolTip="{Binding ScanStorePath}" />
                                    <TextBlock Text="{Binding ScanWarnings}" Style="{StaticResource MutedText}"
                                               Margin="0,0,0,4" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Import scan"
                                    Command="{Binding ImportScanCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center" Margin="20,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Reconstruction settings -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Reconstruction settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Stored with the project. These values drive wall, floor and opening reconstruction from Phase 5."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                                    <TextBlock Text="BUILDING TYPE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding BuildingTypes}"
                                              SelectedItem="{Binding SelectedBuildingType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                    <TextBlock Text="DEFAULT WALL HEIGHT (M)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WallHeightText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                                    <TextBlock Text="DEFAULT FLOOR THICKNESS (M)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding FloorThicknessText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                    <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.5" Maximum="1.0"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding ConfidenceThreshold}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceThreshold, StringFormat={}{0:P0}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </Grid>
                                </StackPanel>

                                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                          Content="Mark inferred geometry explicitly"
                                          IsChecked="{Binding MarkInferredGeometry}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Levels -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Levels" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ElevationUnitLabel, StringFormat='Elevations are shown in {0}. New levels are written to Revit only when you click Create levels.'}"
                                       Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                            <DataGrid ItemsSource="{Binding Levels}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      Height="190"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Elevation" Binding="{Binding ElevationText}" Width="130" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0"
                                         Text="{Binding NewLevelName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="New level name" />
                                <TextBox Grid.Column="1" Margin="0,0,8,0"
                                         Text="{Binding NewLevelElevationText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Elevation in project units" />
                                <Button Grid.Column="2" Content="Add" Command="{Binding AddLevelCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveLevelCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </Grid>

                            <Button Content="Create levels in Revit"
                                    Command="{Binding CreateLevelsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Processing -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Processing" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DETECTED ELEMENTS" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DetectedElements}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="MEAN CONFIDENCE" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Engine -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Python engine" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding EngineDetails}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding LogDirectory, StringFormat='Logs: {0}'}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test connection" Command="{Binding TestEngineCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="28,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Phase 3 · point cloud import and spatial index"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
