<Window x:Class="RevoAI.Revit.UI.ReconstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Generate BIM"
        Width="1020" Height="900"
        MinWidth="860" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Generate BIM" Style="{StaticResource TitleText}" />
            <TextBlock Text="Preview native Revit floors and walls from Scan Analysis. Nothing is created until you click Create in Revit."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Reconstruction plan" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <TextBlock Text="SCAN STORE" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StorePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <TextBlock Text="The store must already contain analysis/segmentation.json from Scan Analysis."
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Plan parameters" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ConfidenceThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                <TextBlock Text="FALLBACK WALL HEIGHT (M)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FallbackWallHeightText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="LEVEL TOLERANCE (M)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding LevelToleranceText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="MAX ELEMENTS" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MaxElementsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                                <CheckBox Content="Mark created floors and walls as REVO-INFERRED"
                                          IsChecked="{Binding MarkInferred}"
                                          IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Generation error" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                    Command="{Binding OpenStoreFolderCommand}"
                                    Style="{StaticResource GhostButton}" />
                            <TextBlock Text="Plan preview" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding PlanSummary}" FontFamily="Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />

                        <TextBlock Text="Floors" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <DataGrid ItemsSource="{Binding Floors}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="180"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="130" />
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelId}" Width="110" />
                                <DataGridTextColumn Header="Area m²" Binding="{Binding AreaM2, StringFormat={}{0:0.##}}" Width="100" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Walls" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <DataGrid ItemsSource="{Binding Walls}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="220"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="130" />
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelId}" Width="110" />
                                <DataGridTextColumn Header="Height m" Binding="{Binding HeightMeters, StringFormat={}{0:0.###}}" Width="100" />
                                <DataGridTextColumn Header="Height source" Binding="{Binding HeightSource}" Width="120" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding WarningsText}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding PreviewButtonText}"
                    Command="{Binding PreviewCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="12,0,8,0" />
            <Button Grid.Column="2" Content="{Binding BuildButtonText}"
                    Command="{Binding BuildCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Close" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
