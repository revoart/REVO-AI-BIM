<Window x:Class="RevoAI.Revit.UI.ScanAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revo AI BIM — Scan Analysis"
        Width="980" Height="860"
        MinWidth="840" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevoAI.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Scan analysis" Style="{StaticResource TitleText}" />
            <TextBlock Text="Geometric semantic/instance segmentation of the imported point cloud. This is a measured plane-fit baseline, not a trained neural network."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Point cloud store" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding StorePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <TextBlock Text="Choose the folder that contains metadata.json. Import Scan creates one automatically."
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Analysis parameters" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="VOXEL SIZE (M, 0 = OFF)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding VoxelSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                <TextBlock Text="MAX ANALYSIS POINTS" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MaxPointsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="PLANE DISTANCE (M)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PlaneDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="MIN PLANE POINTS" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MinPlanePointsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="MAX PLANES" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MaxPlanesText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ConfidenceThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Analysis error" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Open scan folder"
                                    Command="{Binding OpenStoreFolderCommand}"
                                    Style="{StaticResource GhostButton}" />
                            <TextBlock Text="Analysis result" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ResultSummary}" FontFamily="Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />

                        <TextBlock Text="Detected planar instances" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <DataGrid ItemsSource="{Binding Elements}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="280"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120" />
                                <DataGridTextColumn Header="Points" Binding="{Binding PointCount, StringFormat={}{0:N0}}" Width="90" />
                                <DataGridTextColumn Header="Area m²" Binding="{Binding AreaM2, StringFormat={}{0:0.##}}" Width="90" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="100" />
                                <DataGridTextColumn Header="Plane error (m)" Binding="{Binding Signals.FitErrorMeters, StringFormat={}{0:0.####}}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Warnings" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding WarningsText}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding RunButtonText}"
                    Command="{Binding RunCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="12,0,8,0" />
            <Button Grid.Column="2" Content="Close" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
